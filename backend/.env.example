# Environment Variables Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True

# LLM Providers (Optional - application runs with high-fidelity contextual fallback if unset)
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini

# Database (Optional - Supabase / PostgreSQL with pgvector)
# If omitted, application uses the built-in in-memory cosine vector store automatically.
DATABASE_URL=
VECTOR_DIMENSION=768
TOP_K_RETRIEVAL=4
